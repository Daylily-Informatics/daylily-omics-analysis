library(dplyr)
library(ggplot2)

footprint_to_plot <- "hg38"

d_heat <- d %>%
  filter(CmpFootprint == footprint_to_plot) %>%
  mutate(
    Downsample = as.numeric(Primary_Tgt_Cov),
    AC = paste(Aligner, SNVCaller, sep = "+")
  ) %>%
  group_by(Downsample, AC) %>%
  summarise(
    Fscore = mean(Fscore, na.rm = TRUE),
    Precision = mean(Precision, na.rm = TRUE),
    Recall = mean(Sensitivity.Recall, na.rm = TRUE),
    TP = sum(TP, na.rm = TRUE),
    FN = sum(FN, na.rm = TRUE),
    FP = sum(FP, na.rm = TRUE),
    .groups = "drop"
  )
d_heat <- d_heat %>%
  mutate(
    label_big   = sprintf("%.3f", Fscore),
    label_small = sprintf("P: %.2f  R: %.2f\nTP:%d  FN:%d  FP:%d",
                          Precision, Recall, TP, FN, FP)
  )
ggplot(d_heat, aes(x = AC, y = Downsample, fill = Fscore)) +
  geom_tile(color = "white") +

  # Big Fscore
  geom_text(aes(label = label_big),
            size = 5,
            fontface = "bold",
            color = "white") +

  # Smaller stats
  geom_text(aes(label = label_small),
            size = 3,
            vjust = 2,
            color = "white") +

  scale_y_continuous(
    limits = c(0, 50),
    breaks = seq(0, 50, 5),
    expand = c(0, 0)
  ) +

  scale_fill_viridis_c(
    option = "magma",
    limits = c(0, 1),
    na.value = "grey90"
  ) +

  theme_minimal(base_size = 12) +
  theme(
    axis.text.x = element_text(angle = 90, hjust = 1),
    panel.grid = element_blank()
  ) +

  labs(
    title = paste("Fscore Heatmap — Footprint:", footprint_to_plot),
    subtitle = "Large = Fscore | Small = Precision, Recall, TP/FN/FP",
    x = "Aligner + Caller",
    y = "Downsample Level (X)",
    fill = "Fscore"
  )
library(dplyr)
library(ggplot2)

footprint_to_plot <- "hg38"

d_heat <- d %>%
  filter(
    CmpFootprint == footprint_to_plot,
    SNPClass == "All"
  ) %>%
  mutate(
    Downsample = as.numeric(Primary_Tgt_Cov),
    AC = paste(Aligner, SNVCaller, sep = "+")
  ) %>%
  group_by(Downsample, AC) %>%
  summarise(
    TP = sum(TP, na.rm = TRUE),
    FN = sum(FN, na.rm = TRUE),
    FP = sum(FP, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  mutate(
    Precision = TP / (TP + FP),
    Recall    = TP / (TP + FN),
    Fscore    = 2 * TP / (2 * TP + FP + FN)
  )
summary(d_heat$Fscore)
d_heat <- d_heat %>%
  mutate(
    label_big   = sprintf("%.4f", Fscore),
    label_small = sprintf("P: %.4f  R: %.4f\nTP:%d  FN:%d  FP:%d",
                          Precision, Recall, TP, FN, FP)
  )
ggplot(d_heat, aes(x = AC, y = Downsample, fill = Fscore)) +
  geom_tile(color = "white") +

  geom_text(aes(label = label_big),
            size = 5,
            fontface = "bold",
            color = "white") +

  geom_text(aes(label = label_small),
            size = 3,
            vjust = 2,
            color = "white") +

  scale_y_continuous(
    limits = c(0, 50),
    breaks = seq(0, 50, 5),
    expand = c(0, 0)
  ) +

  scale_fill_viridis_c(
    option = "magma",
    limits = c(0, 1),
    na.value = "grey90"
  ) +

  theme_minimal(base_size = 12) +
  theme(
    axis.text.x = element_text(angle = 90, hjust = 1),
    panel.grid = element_blank()
  ) +

  labs(
    title = paste("Fscore Heatmap — Footprint:", footprint_to_plot, "| SNPClass: All"),
    subtitle = "Large = Fscore | Small = Precision, Recall, TP/FN/FP",
    x = "Aligner + Caller",
    y = "Downsample Level (X)",
    fill = "Fscore"
  )
ggplot(d_heat, aes(x = AC, y = Downsample, fill = Fscore)) +

  geom_tile(width = 1, height = 5) +

  geom_text(aes(label = label_big),
            size = 4,
            fontface = "bold",
            color = "white") +

  geom_text(aes(label = label_small),
            size = 2.5,
            vjust = 1.8,
            color = "white") +

  scale_y_continuous(
    limits = c(0, 50),
    breaks = seq(0, 50, 5),
    expand = c(0, 0)
  ) +

  scale_x_discrete(expand = c(0, 0)) +

  scale_fill_viridis_c(
    option = "magma",
    limits = c(0, 1),
    na.value = "grey90"
  ) +

  coord_fixed(ratio = 1) +

  theme_minimal(base_size = 12) +
  theme(
    panel.grid = element_blank(),
    axis.text.x = element_text(angle = 90, hjust = 1),
    plot.margin = margin(0, 0, 0, 0)
  ) +

  labs(
    title = paste("Fscore Heatmap — Footprint:", footprint_to_plot, "| SNPClass: All"),
    x = "Aligner + Caller",
    y = "Downsample Level (X)",
    fill = "Fscore"
  )
ggplot(d_heat, aes(
    x = AC,
    y = factor(Downsample, levels = sort(unique(Downsample))),
    fill = Fscore
  )) +

  geom_tile(width = 1, height = 1) +

  geom_text(aes(label = label_big),
            size = 3.5,
            fontface = "bold",
            color = "white") +

  geom_text(aes(label = label_small),
            size = 2,
            vjust = 2,
            color = "white") +

  scale_x_discrete(expand = c(0,0)) +
  scale_y_discrete(expand = c(0,0)) +

  scale_fill_viridis_c(
    option = "magma",
    limits = c(0,1)
  ) +

  theme_minimal(base_size = 11) +
  theme(
    panel.grid = element_blank(),
    axis.text.x = element_text(angle = 90, hjust = 1)
  ) +

  labs(
    title = paste("Fscore Heatmap — Footprint:", footprint_to_plot, "| SNPClass: All"),
    x = "Aligner + Caller",
    y = "Downsample Level",
    fill = "Fscore"
  )
d_heat <- d_heat %>%
  mutate(
    text_color = ifelse(Fscore > 0.8, "black", "white")
  )
ggplot(d_heat, aes(
    x = AC,
    y = factor(Downsample, levels = sort(unique(Downsample))),
    fill = Fscore
  )) +

  geom_tile(width = 1, height = 1) +

  geom_text(aes(label = label_big, color = text_color),
            size = 3.5,
            fontface = "bold") +

  geom_text(aes(label = label_small, color = text_color),
            size = 2,
            vjust = 2) +

  scale_color_identity() +

  scale_x_discrete(expand = c(0,0)) +
  scale_y_discrete(expand = c(0,0)) +

  scale_fill_viridis_c(
    option = "magma",
    limits = c(0,1)
  ) +

  theme_minimal(base_size = 11) +
  theme(
    panel.grid = element_blank(),
    axis.text.x = element_text(angle = 90, hjust = 1)
  ) +

  labs(
    title = paste("Fscore Heatmap — Footprint:", footprint_to_plot, "| SNPClass: All"),
    x = "Aligner + Caller",
    y = "Downsample Level",
    fill = "Fscore"
  )
d_heat <- d_heat %>%
  mutate(
    y_factor = factor(Downsample, levels = sort(unique(Downsample))),
    x_factor = factor(AC),

    x_id = as.numeric(x_factor),
    y_id = as.numeric(y_factor)
  )
ggplot(d_heat) +

  geom_tile(
    aes(x = x_id, y = y_id, fill = Fscore),
    width = 1, height = 1
  ) +

  # ---- Fscore (upper left)
  geom_text(
    aes(x = x_id - 0.45, y = y_id + 0.35,
        label = sprintf("%.4f", Fscore),
        color = text_color),
    hjust = 0,
    size = 3.5,
    fontface = "bold"
  ) +

  # ---- Precision (upper right)
  geom_text(
    aes(x = x_id + 0.45, y = y_id + 0.35,
        label = sprintf("P: %.3f", Precision),
        color = text_color),
    hjust = 1,
    size = 2.5
  ) +

  # ---- Recall (below precision, upper right)
  geom_text(
    aes(x = x_id + 0.45, y = y_id + 0.15,
        label = sprintf("R: %.3f", Recall),
        color = text_color),
    hjust = 1,
    size = 2.5
  ) +

  # ---- True Pos (lower left)
  geom_text(
    aes(x = x_id - 0.45, y = y_id - 0.35,
        label = sprintf("TP:%d", TP),
        color = text_color),
    hjust = 0,
    size = 2.5
  ) +

  # ---- False Neg (lower right)
  geom_text(
    aes(x = x_id + 0.45, y = y_id - 0.15,
        label = sprintf("FN:%d", FN),
        color = text_color),
    hjust = 1,
    size = 2.5
  ) +

  # ---- False Pos (bottom right)
  geom_text(
    aes(x = x_id + 0.45, y = y_id - 0.35,
        label = sprintf("FP:%d", FP),
        color = text_color),
    hjust = 1,
    size = 2.5
  ) +

  scale_x_continuous(
    breaks = unique(d_heat$x_id),
    labels = levels(d_heat$x_factor),
    expand = c(0,0)
  ) +

  scale_y_continuous(
    breaks = unique(d_heat$y_id),
    labels = levels(d_heat$y_factor),
    expand = c(0,0)
  ) +

  scale_fill_viridis_c(option = "magma", limits = c(0,1)) +
  scale_color_identity() +

  theme_minimal(base_size = 11) +
  theme(
    panel.grid = element_blank(),
    axis.text.x = element_text(angle = 90, hjust = 1)
  ) +

  labs(
    title = paste("Fscore Heatmap — Footprint:", footprint_to_plot, "| SNPClass: All"),
    x = "Aligner + Caller",
    y = "Downsample Level",
    fill = "Fscore"
  )
library(dplyr)
library(ggplot2)
library(scales)

# aggregate with count of contributing rows
d_heat <- d %>%
  filter(
    CmpFootprint == footprint_to_plot,
    SNPClass == "All"
  ) %>%
  mutate(
    Downsample = as.numeric(Primary_Tgt_Cov),
    AC = paste(Aligner, SNVCaller, sep = "+")
  ) %>%
  group_by(Downsample, AC) %>%
  summarise(
    TP = sum(TP, na.rm = TRUE),
    FN = sum(FN, na.rm = TRUE),
    FP = sum(FP, na.rm = TRUE),
    n_metrics = n(),
    .groups = "drop"
  ) %>%
  mutate(
    Precision = TP / (TP + FP),
    Recall    = TP / (TP + FN),
    Fscore    = 2 * TP / (2 * TP + FP + FN),

    TP_fmt = label_number_si(accuracy = 0.1)(TP),
    FN_fmt = label_number_si(accuracy = 0.1)(FN),
    FP_fmt = label_number_si(accuracy = 0.1)(FP),

    y_factor = factor(Downsample, levels = sort(unique(Downsample))),
    x_factor = factor(AC),

    x_id = as.numeric(x_factor),
    y_id = as.numeric(y_factor),

    text_color = ifelse(Fscore > 0.8, "black", "white")
  )
library(scales)

d_heat <- d %>%
  filter(
    CmpFootprint == footprint_to_plot,
    SNPClass == "All"
  ) %>%
  mutate(
    Downsample = as.numeric(Primary_Tgt_Cov),
    AC = paste(Aligner, SNVCaller, sep = "+")
  ) %>%
  group_by(Downsample, AC) %>%
  summarise(
    TP = sum(TP, na.rm = TRUE),
    FN = sum(FN, na.rm = TRUE),
    FP = sum(FP, na.rm = TRUE),
    n_metrics = n(),
    .groups = "drop"
  ) %>%
  mutate(
    Precision = TP / (TP + FP),
    Recall    = TP / (TP + FN),
    Fscore    = 2 * TP / (2 * TP + FP + FN),

    # modern SI formatting
    TP_fmt = label_number(scale_cut = cut_short_scale(), accuracy = 0.1)(TP),
    FN_fmt = label_number(scale_cut = cut_short_scale(), accuracy = 0.1)(FN),
    FP_fmt = label_number(scale_cut = cut_short_scale(), accuracy = 0.1)(FP),

    y_factor = factor(Downsample, levels = sort(unique(Downsample))),
    x_factor = factor(AC),

    x_id = as.numeric(x_factor),
    y_id = as.numeric(y_factor),

    text_color = ifelse(Fscore > 0.8, "black", "white")
  )
ggplot(d_heat) +

  geom_tile(
    aes(x = x_id, y = y_id, fill = Fscore),
    width = 1.1, height = 1.1
  ) +

  # Fscore (center)
  geom_text(
    aes(x = x_id, y = y_id,
        label = sprintf("%.3f", Fscore),
        color = text_color),
    size = 3.5,
    fontface = "bold"
  ) +

  # TP (center lower)
  geom_text(
    aes(x = x_id, y = y_id - 0.22,
        label = paste0("TP:", TP_fmt),
        color = text_color),
    size = 2.1
  ) +

  # Precision + Recall (lower left stacked)
  geom_text(
    aes(x = x_id - 0.40, y = y_id - 0.15,
        label = sprintf("P: %.3f", Precision),
        color = text_color),
    hjust = 0,
    size = 2.1
  ) +

  geom_text(
    aes(x = x_id - 0.40, y = y_id - 0.32,
        label = sprintf("R: %.3f", Recall),
        color = text_color),
    hjust = 0,
    size = 2.1
  ) +

  # FN + FP (lower right stacked)
  geom_text(
    aes(x = x_id + 0.40, y = y_id - 0.15,
        label = paste0("FN:", FN_fmt),
        color = text_color),
    hjust = 1,
    size = 2.1
  ) +

  geom_text(
    aes(x = x_id + 0.40, y = y_id - 0.32,
        label = paste0("FP:", FP_fmt),
        color = text_color),
    hjust = 1,
    size = 2.1
  ) +

  # n contributing metrics (top center small)
  geom_text(
    aes(x = x_id, y = y_id + 0.32,
        label = paste0("n=", n_metrics),
        color = text_color),
    size = 2.1
  ) +

  scale_x_continuous(
    breaks = unique(d_heat$x_id),
    labels = levels(d_heat$x_factor),
    expand = c(0,0)
  ) +

  scale_y_continuous(
    breaks = unique(d_heat$y_id),
    labels = levels(d_heat$y_factor),
    expand = c(0,0)
  ) +

  scale_fill_viridis_c(option = "magma", limits = c(0,1)) +
  scale_color_identity() +

  theme_minimal(base_size = 11) +
  theme(
    panel.grid = element_blank(),
    axis.text.x = element_text(angle = 90, hjust = 1)
  ) +

  labs(
    title = paste("Fscore Heatmap — Footprint:", footprint_to_plot, "| SNPClass: All"),
    x = "Aligner + Caller",
    y = "Downsample Level",
    fill = "Fscore"
  )
ggplot(d_heat) +

  geom_tile(
    aes(x = x_id, y = y_id, fill = Fscore),
    width = 1.1, height = 1.1
  ) +

  # ---- FSCORE (UPPER LEFT)
  geom_text(
    aes(
      x = x_id - 0.45,
      y = y_id + 0.45,
      label = sprintf("%.3f", Fscore),
      color = text_color
    ),
    hjust = 0,
    vjust = 1,
    size = 3.5,
    fontface = "bold"
  ) +

  # ---- PRECISION (LOWER LEFT TOP)
  geom_text(
    aes(
      x = x_id - 0.45,
      y = y_id - 0.15,
      label = sprintf("P: %.3f", Precision),
      color = text_color
    ),
    hjust = 0,
    size = 2.1
  ) +

  # ---- RECALL (LOWER LEFT BELOW)
  geom_text(
    aes(
      x = x_id - 0.45,
      y = y_id - 0.32,
      label = sprintf("R: %.3f", Recall),
      color = text_color
    ),
    hjust = 0,
    size = 2.1
  ) +

  # ---- FN (LOWER RIGHT TOP)
  geom_text(
    aes(
      x = x_id + 0.45,
      y = y_id - 0.15,
      label = paste0("FN:", FN_fmt),
      color = text_color
    ),
    hjust = 1,
    size = 2.1
  ) +

  # ---- FP (LOWER RIGHT BELOW)
  geom_text(
    aes(
      x = x_id + 0.45,
      y = y_id - 0.32,
      label = paste0("FP:", FP_fmt),
      color = text_color
    ),
    hjust = 1,
    size = 2.1
  ) +

  # ---- TP (CENTER)
  geom_text(
    aes(
      x = x_id,
      y = y_id,
      label = paste0("TP:", TP_fmt),
      color = text_color
    ),
    size = 2.1
  ) +

  # ---- n (TOP CENTER)
  geom_text(
    aes(
      x = x_id,
      y = y_id + 0.45,
      label = paste0("n=", n_metrics),
      color = text_color
    ),
    vjust = 0,
    size = 2.1
  ) +

  scale_x_continuous(
    breaks = unique(d_heat$x_id),
    labels = levels(d_heat$x_factor),
    expand = c(0,0)
  ) +

  scale_y_continuous(
    breaks = unique(d_heat$y_id),
    labels = levels(d_heat$y_factor),
    expand = c(0,0)
  ) +

  scale_fill_viridis_c(option = "magma", limits = c(0,1)) +
  scale_color_identity() +

  theme_minimal(base_size = 11) +
  theme(
    panel.grid = element_blank(),
    axis.text.x = element_text(angle = 90, hjust = 1)
  )
ggplot(d_heat) +

  geom_tile(
    aes(x = x_id, y = y_id, fill = Fscore),
    width = 1.1, height = 1.1
  ) +

  # ---- FSCORE (UPPER LEFT)
  geom_text(
    aes(
      x = x_id - 0.48,
      y = y_id + 0.48,
      label = sprintf("%.3f", Fscore),
      color = text_color
    ),
    hjust = 0,
    vjust = 1,
    size = 3.5,
    fontface = "bold"
  ) +

  # ---- n (UPPER RIGHT)
  geom_text(
    aes(
      x = x_id + 0.48,
      y = y_id + 0.48,
      label = paste0("n=", n_metrics),
      color = text_color
    ),
    hjust = 1,
    vjust = 1,
    size = 1.9
  ) +

  # ---- Precision
  geom_text(
    aes(
      x = x_id - 0.48,
      y = y_id + 0.28,
      label = sprintf("P: %.3f", Precision),
      color = text_color
    ),
    hjust = 0,
    size = 1.9
  ) +

  # ---- Recall
  geom_text(
    aes(
      x = x_id - 0.48,
      y = y_id + 0.15,
      label = sprintf("R: %.3f", Recall),
      color = text_color
    ),
    hjust = 0,
    size = 1.9
  ) +

  # ---- TP
  geom_text(
    aes(
      x = x_id - 0.48,
      y = y_id + 0.02,
      label = paste0("TP:", TP_fmt),
      color = text_color
    ),
    hjust = 0,
    size = 1.9
  ) +

  # ---- FN
  geom_text(
    aes(
      x = x_id - 0.48,
      y = y_id - 0.11,
      label = paste0("FN:", FN_fmt),
      color = text_color
    ),
    hjust = 0,
    size = 1.9
  ) +

  # ---- FP
  geom_text(
    aes(
      x = x_id - 0.48,
      y = y_id - 0.24,
      label = paste0("FP:", FP_fmt),
      color = text_color
    ),
    hjust = 0,
    size = 1.9
  ) +

  scale_x_continuous(
    breaks = unique(d_heat$x_id),
    labels = levels(d_heat$x_factor),
    expand = c(0,0)
  ) +

  scale_y_continuous(
    breaks = unique(d_heat$y_id),
    labels = levels(d_heat$y_factor),
    expand = c(0,0)
  ) +

  scale_fill_viridis_c(option = "magma", limits = c(0,1)) +
  scale_color_identity() +

  theme_minimal(base_size = 11) +
  theme(
    panel.grid = element_blank(),
    axis.text.x = element_text(angle = 90, hjust = 1)
  )
