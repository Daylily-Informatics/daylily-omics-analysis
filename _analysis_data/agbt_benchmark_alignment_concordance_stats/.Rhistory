# ---- FILTER + CONSOLIDATE ----
d_heat <- d %>%
  filter(CmpFootprint == "cmdFootprint_hg38") %>%   # adjust string if needed
  mutate(
    Downsample = Primary_Tgt_Cov,
    AC = paste(Aligner, SNVCaller, sep = "+")
  ) %>%
  group_by(SNPClass, Downsample, AC) %>%
  summarise(
    Fscore = mean(Fscore, na.rm = TRUE),
    .groups = "drop"
  )
plot_heatmap <- function(df, snp_class) {

  df %>%
    filter(SNPClass == snp_class) %>%
    mutate(
      Downsample = factor(Downsample, levels = sort(unique(Downsample))),
      AC = fct_reorder(AC, Fscore, .fun = mean, .desc = TRUE)
    ) %>%
    ggplot(aes(x = AC, y = Downsample, fill = Fscore)) +
    geom_tile() +
    scale_fill_viridis_c(option = "magma", limits = c(0,1), na.value = "grey90") +
    labs(
      title = paste("Fscore Heatmap —", snp_class),
      x = "Aligner + Caller",
      y = "Downsample Level",
      fill = "Fscore"
    ) +
    theme_minimal(base_size = 12) +
    theme(
      axis.text.x = element_text(angle = 90, vjust = 0.5, hjust = 1),
      panel.grid = element_blank()
    )
}
unique_classes <- unique(d_heat$SNPClass)

plots <- lapply(unique_classes, function(sc) {
  plot_heatmap(d_heat, sc)
})

