        type: string
    SAMPLEID:
        type: string
    EXPERIMENTID:
        type: string
    LANEID:
        type: string
    BARCODEID:
        type: string
    LIBPREP:
        type: string
    SEQ_PLATFORM:
        type: string
    SEQ_VENDOR:
        type: string
    ILMN_R1_PATH:
        type: string
    ILMN_R2_PATH:
        type: string
    PACBIO_R1_PATH:
        type: string
    PACBIO_R2_PATH:
        type: string
    ONT_R1_PATH:
        type: string
    ONT_R2_PATH:
        type: string
    UG_R1_PATH:
        type: string
    UG_R2_PATH:
        type: string
    SUBSAMPLE_PCT:
        type: string
required:
    - RUNID
    - SAMPLEID
    - EXPERIMENTID
    - LANEID
    - BARCODEID
    - LIBPREP
    - SEQ_PLATFORM
