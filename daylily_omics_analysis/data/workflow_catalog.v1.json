  "workflows": [
    {
      "workflow_id": "test_help",
      "display_name": "CLI Help Smoke Test",
      "description": "Validate the dy-cli shell wiring and command composition without launching a real analysis.",
      "supported_genome_builds": [
        "hg38",
        "hg38_broad",
        "b37"
      ],
      "default_genome_build": "hg38",
      "supported_execution_profiles": [
        "local",
        "slurm"
      ],
      "default_execution_profile": "local",
      "required_inputs": [],
      "targets": [
        "help"
      ],
      "options": [
        {
          "option_id": "print_commands",
          "label": "Print shell commands",
          "description": "Include -p so Snakemake prints the composed shell commands.",
          "type": "boolean",
          "default": true,
          "render_as": "flag",
          "flag": "-p"
        },
        {
          "option_id": "jobs",
          "label": "Parallel jobs",
          "description": "Maximum active jobs passed to dy-r.",
          "type": "integer",
          "default": 1,
          "minimum": 1,
          "maximum": 20,
          "render_as": "arg",
          "flag": "-j"
        }
      ]
    },
    {
      "workflow_id": "germline_wgs_snv",
