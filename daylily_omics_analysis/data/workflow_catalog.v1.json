      "required_inputs": [
        {
          "input_id": "workset_manifest",
          "label": "Workset manifest",
          "description": "A saved or uploaded workset manifest that will be staged into samples.tsv and units.tsv before launch.",
          "required": true
        }
      ],
      "targets": [
        "produce_alignstats",
        "produce_snv_concordances"
